# Firebase client (public — safe for the browser)
# Copy to .env.local and fill in from Firebase Console → Project settings
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Twilio Verify (server-only — NEVER prefix with NEXT_PUBLIC_)
# From Twilio Console → Account Info + Verify → Services
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Firebase Admin SDK (server-only — NEVER prefix with NEXT_PUBLIC_)
# Paste the full service-account JSON as a single-line string.
# Tip: jq -c . serviceAccount.json
# Private-key newlines can stay as \n inside the JSON string.
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=

# Optional shared secret for manual due-soon reminder triggers
# (POST /api/notifications/due-soon and Cloud Function HTTP trigger)
REMINDER_TRIGGER_SECRET=

# Optional secret for manual booking-automation triggers
# (GET/POST /api/cron/automation)
AUTOMATION_TRIGGER_SECRET=

# Resend transactional email (server-only — NEVER prefix with NEXT_PUBLIC_)
# Create a free account at https://resend.com → API Keys → Create API Key
# Without this key, payment/booking/dispute emails are skipped safely
# ("Email delivery not yet configured") and never break core flows.
RESEND_API_KEY=
# Optional From address. Use a verified domain for reliable inbox delivery.
# Until you verify a domain, Resend’s onboarding address only delivers to
# your Resend account email (not arbitrary recipients).
# Example after domain verify: Shaadi Saathi <noreply@mail.yourdomain.com>
RESEND_FROM_EMAIL=

# Upstash Vector — wedding knowledge RAG (server-only)
# Create an index at https://console.upstash.com/vector WITH a built-in
# embedding model (recommended: BGE Small EN). Then paste REST URL + token.
# Without these, /api/wedding-chat returns 503 and never affects other flows.
# After setting keys, run: npx tsx scripts/embed-knowledge-base.ts
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Sentry error monitoring
# DSNs are public identifiers and are safe to expose to the browser.
NEXT_PUBLIC_SENTRY_DSN=

# Optional build-time source map upload (SENTRY_AUTH_TOKEN is server-only).
# Generate the source-map upload token from your Sentry project setup.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
