rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isWeddingMember(weddingId) {
      return isSignedIn()
        && weddingId != null
        && request.auth.uid in get(/databases/$(database)/documents/weddings/$(weddingId)).data.memberUids;
    }

    /** Financial approvals — only the wedding ownerId (not collaborators). */
    function isWeddingOwner(weddingId) {
      return isSignedIn()
        && weddingId != null
        && get(/databases/$(database)/documents/weddings/$(weddingId)).data.ownerId == request.auth.uid;
    }

    function isVendorOwner(vendorId) {
      return isSignedIn()
        && vendorId != null
        && get(/databases/$(database)/documents/vendors/$(vendorId)).data.ownerUid == request.auth.uid;
    }

    /** Collaborators may not rewrite ownership; owner may (future transfer). */
    function weddingOwnershipFieldsUnchanged() {
      return request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.memberUids == resource.data.memberUids;
    }

    /** Non-financial booking touch (message read receipts). */
    function bookingFamilyReadReceiptOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['lastReadByFamily']);
    }

    function isPlatformAdmin() {
      return isSignedIn() && request.auth.token.platformAdmin == true;
    }

    /**
     * Vendor owners may edit listing fields and submit KYC for review (pending),
     * but cannot set themselves to verified/rejected or clear admin review fields.
     */
    function vendorVerificationSubmitOnly() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'verificationStatus',
          'verificationCnic',
          'verificationBusinessName',
          'verificationCity',
          'verificationSubmittedAt',
          'verificationRejectionReason',
        ])
        && request.resource.data.verificationStatus == 'pending'
        && resource.data.get('verificationStatus', 'unverified') in ['unverified', 'rejected']
        && request.resource.data.verificationCnic is string
        && request.resource.data.verificationCnic.size() >= 5
        && request.resource.data.verificationCnic.size() <= 20
        && request.resource.data.verificationBusinessName is string
        && request.resource.data.verificationBusinessName.size() >= 2
        && request.resource.data.verificationCity is string
        && request.resource.data.verificationCity.size() >= 2;
    }

    function vendorOwnerUpdateAllowed() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return vendorVerificationSubmitOnly()
        || (
          !changed.hasAny([
            'verificationStatus',
            'verificationCnic',
            'verificationBusinessName',
            'verificationCity',
            'verificationSubmittedAt',
            'verificationReviewedAt',
            'verificationRejectionReason',
            'ownerUid',
          ])
        );
    }

    function guestRsvpOnlyUpdate() {
      // Public invite link may update RSVP fields without auth.
      let allowed = ['rsvp', 'rsvpSource', 'updatedAt', 'rsvpUpdatedAt', 'rsvpOrganiserAlert'];
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(allowed);
    }

    // Unauthenticated wedding-invite self-claim (create only). Doc id must
    // equal inviteToken; wedding must exist; RSVP fields start as pending.
    function isPublicWeddingGuestClaim() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'id', 'weddingId', 'name', 'phone', 'events',
          'rsvp', 'rsvpSource', 'rsvpUpdatedAt', 'rsvpOrganiserAlert',
          'inviteToken', 'notes', 'updatedAt'
        ])
        && d.weddingId is string
        && d.weddingId.size() > 0
        && d.weddingId.size() <= 128
        && exists(/databases/$(database)/documents/weddings/$(d.weddingId))
        && d.name is string
        && d.name.size() >= 2
        && d.name.size() <= 80
        && d.inviteToken is string
        && d.inviteToken == request.resource.id
        && d.id is string
        && d.phone is string
        && d.phone.size() <= 40
        && d.events is list
        && d.rsvp is map
        && d.rsvpSource is map
        && d.rsvpUpdatedAt is map
        && d.rsvpOrganiserAlert is map
        && d.updatedAt is number
        && (!d.keys().hasAny(['notes']) || (d.notes is string && d.notes.size() <= 200));
    }

    // Client-side OTP audit logs (written pre-auth). Shape/size limited;
    // readable by platform admin claim or Admin SDK only.
    function isValidVerificationError() {
      let d = request.resource.data;
      return d.keys().hasOnly(['flow', 'stage', 'code', 'message', 'rawCode', 'rawMessage', 'phone', 'uid', 'timestamp'])
        && d.flow is string && d.flow.size() <= 40
        && d.stage is string && d.stage.size() <= 20
        && d.code is string && d.code.size() <= 100
        && d.message is string && d.message.size() <= 500
        && (!d.keys().hasAny(['rawCode']) || (d.rawCode is string && d.rawCode.size() <= 100))
        && (!d.keys().hasAny(['rawMessage']) || (d.rawMessage is string && d.rawMessage.size() <= 500))
        && d.phone is string && d.phone.size() <= 40
        && d.uid is string && d.uid.size() <= 128
        && d.timestamp is number;
    }

    function isValidVerificationSuccess() {
      let d = request.resource.data;
      return d.keys().hasOnly(['flow', 'phone', 'verificationId', 'hasVerificationId', 'uid', 'timestamp'])
        && d.flow is string && d.flow.size() <= 40
        && d.phone is string && d.phone.size() <= 40
        && d.verificationId is string && d.verificationId.size() > 0 && d.verificationId.size() <= 24
        && d.hasVerificationId is bool && d.hasVerificationId == true
        && d.uid is string && d.uid.size() <= 128
        && d.timestamp is number;
    }

    match /users/{userId} {
      allow read: if isPlatformAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /weddings/{weddingId} {
      // Public guest invite pages need couple name + theme without auth.
      allow get: if true;
      allow list: if isWeddingMember(weddingId) || isPlatformAdmin();
      allow create: if isSignedIn();
      // Owner: full update (incl. future ownerId transfer). Collaborators: anything
      // except ownerId/memberUids (those change via Admin SDK on invite accept).
      allow update: if isPlatformAdmin()
        || isWeddingOwner(weddingId)
        || (isWeddingMember(weddingId) && weddingOwnershipFieldsUnchanged());
      allow delete: if isWeddingOwner(weddingId) || isPlatformAdmin();
    }

    match /guests/{inviteToken} {
      allow get: if true;
      allow list: if isPlatformAdmin()
        || (isSignedIn() && isWeddingMember(resource.data.weddingId));
      allow create: if (isSignedIn()
          && isWeddingMember(request.resource.data.weddingId))
        || isPublicWeddingGuestClaim();
      allow delete: if isSignedIn()
        && isWeddingMember(resource.data.weddingId);
      allow update: if isWeddingMember(resource.data.weddingId)
        || guestRsvpOnlyUpdate();
    }

    match /tasks/{taskId} {
      allow read: if isPlatformAdmin() || (isSignedIn()
        && isWeddingMember(resource.data.weddingId));
      allow create: if isSignedIn()
        && isWeddingMember(request.resource.data.weddingId);
      allow update, delete: if isSignedIn()
        && isWeddingMember(resource.data.weddingId);
    }

    match /vendors/{vendorId} {
      allow read: if true;
      // New vendors must start unverified — they cannot self-approve for payments.
      allow create: if isSignedIn()
        && request.resource.data.verificationStatus == 'unverified';
      allow update: if isPlatformAdmin()
        || (isVendorOwner(vendorId) && vendorOwnerUpdateAllowed());
      allow delete: if isVendorOwner(vendorId) || isPlatformAdmin();
    }

    // Sensitive bank/IBAN details for Safepay payouts — NOT on the public vendors doc.
    // Owner + platform admin only. Never readable by families or other vendors.
    function isValidPayoutAccountWrite(vendorId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'vendorId', 'ownerUid', 'iban', 'accountHolderName', 'bankName',
          'accountNumber', 'createdAt', 'updatedAt'
        ])
        && d.vendorId == vendorId
        && d.ownerUid == request.auth.uid
        && d.iban is string && d.iban.size() >= 24 && d.iban.size() <= 34
        && d.accountHolderName is string
          && d.accountHolderName.size() >= 2 && d.accountHolderName.size() <= 120
        && d.bankName is string
          && d.bankName.size() >= 2 && d.bankName.size() <= 120
        && (!('accountNumber' in d) || (d.accountNumber is string && d.accountNumber.size() <= 40))
        && d.createdAt is number
        && d.updatedAt is number;
    }

    match /vendor_payout_accounts/{vendorId} {
      allow read: if isPlatformAdmin()
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isSignedIn()
        && isVendorOwner(vendorId)
        && isValidPayoutAccountWrite(vendorId);
      allow update: if isPlatformAdmin()
        || (isSignedIn()
          && isVendorOwner(vendorId)
          && resource.data.ownerUid == request.auth.uid
          && isValidPayoutAccountWrite(vendorId)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if isPlatformAdmin()
        || (isSignedIn()
          && isVendorOwner(vendorId)
          && resource.data.ownerUid == request.auth.uid);
    }

    match /bookings/{bookingId} {
      allow read: if isPlatformAdmin() || (isSignedIn() && (
        isWeddingMember(resource.data.weddingId)
        || isVendorOwner(resource.data.vendorId)
      ));
      // Confirmed bookings must be created via Admin API (/api/bookings/create)
      // so platform-wide date locks can be claimed atomically. Clients may not
      // write confirmed bookings directly.
      allow create: if isPlatformAdmin()
        || (isSignedIn()
          && isWeddingOwner(request.resource.data.weddingId)
          && request.resource.data.status == 'requested');
      // Payment/status/dispute writes: owner or vendor. Collaborators: read receipts only.
      allow update: if isPlatformAdmin()
        || (isSignedIn() && isVendorOwner(resource.data.vendorId))
        || (isSignedIn() && isWeddingOwner(resource.data.weddingId))
        || (isSignedIn()
          && isWeddingMember(resource.data.weddingId)
          && bookingFamilyReadReceiptOnly());
      allow delete: if isWeddingOwner(resource.data.weddingId) || isPlatformAdmin();
    }

    // Denormalized confirmed-date locks for a vendor (vendorId_YYYY-MM-DD).
    // Written only by Admin SDK during booking create. Families/vendors may read
    // to show "Not available on …" before attempting a booking.
    match /vendor_date_locks/{lockId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create, update, delete: if false;
    }

    match /messages/{messageId} {
      allow read: if isPlatformAdmin() || (isSignedIn() && (
        isWeddingMember(get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.weddingId)
        || isVendorOwner(get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.vendorId)
      ));
      allow create: if isSignedIn()
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && (
          isWeddingMember(get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.weddingId)
          || isVendorOwner(get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.vendorId)
        );
      allow update, delete: if false;
    }

    match /typing/{bookingId} {
      allow read, write: if isSignedIn();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isSignedIn()
        && isWeddingMember(request.resource.data.weddingId);
    }

    // OTP audit logs: clients may create (pre-auth) with strict validation;
    // only platform admins may read. Updates/deletes are forbidden.
    match /verification_errors/{errorId} {
      allow create: if isValidVerificationError();
      allow read: if isPlatformAdmin();
      allow update, delete: if false;
    }

    match /verification_success/{successId} {
      allow create: if isValidVerificationSuccess();
      allow read: if isPlatformAdmin();
      allow update, delete: if false;
    }

    function isValidCollaboratorInviteCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'id', 'weddingId', 'phone', 'invitedByUid', 'invitedByName',
          'weddingName', 'status', 'createdAt'
        ])
        && d.weddingId is string && d.weddingId.size() > 0 && d.weddingId.size() <= 128
        && d.phone is string && d.phone.size() >= 8 && d.phone.size() <= 20
        && d.invitedByUid is string && d.invitedByUid == request.auth.uid
        && d.invitedByName is string && d.invitedByName.size() <= 80
        && d.weddingName is string && d.weddingName.size() <= 120
        && d.status == 'pending'
        && d.createdAt is number
        && isWeddingMember(d.weddingId);
    }

    function collaboratorInvitePhoneMatchesUser() {
      return resource.data.phone == userDoc().data.phone;
    }

    match /wedding_collaborator_invites/{inviteId} {
      allow read: if isPlatformAdmin()
        || (isSignedIn() && isWeddingMember(resource.data.weddingId))
        || (isSignedIn() && collaboratorInvitePhoneMatchesUser());
      allow create: if isSignedIn() && isValidCollaboratorInviteCreate();
      allow update: if isPlatformAdmin()
        || (isSignedIn()
          && isWeddingMember(resource.data.weddingId)
          && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        || (isSignedIn()
          && collaboratorInvitePhoneMatchesUser()
          && resource.data.status == 'pending'
          && request.resource.data.status == 'declined'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if false;
    }

    // In-app notifications inbox. Recipients may only read/update their own
    // docs. Wedding members and booking vendors may create for the other party.
    function notificationTypeAllowed(t) {
      return t in [
        'task_assigned', 'task_due_soon',
        'booking_request', 'quote_received', 'quote_accepted', 'quote_rejected',
        'extra_work_needed', 'dispute_raised', 'dispute_vendor_response',
        'dispute_auto_resolved', 'no_show_declared'
      ];
    }

    function bookingDoc(bookingId) {
      return get(/databases/$(database)/documents/bookings/$(bookingId));
    }

    function vendorOwnerUid(vendorId) {
      return get(/databases/$(database)/documents/vendors/$(vendorId)).data.ownerUid;
    }

    function notificationRecipientIsWeddingMember() {
      let d = request.resource.data;
      return d.recipientUid in get(/databases/$(database)/documents/weddings/$(d.weddingId)).data.memberUids;
    }

    function notificationRecipientIsBookingVendor() {
      let d = request.resource.data;
      return d.keys().hasAny(['bookingId'])
        && d.bookingId is string
        && exists(/databases/$(database)/documents/bookings/$(d.bookingId))
        && bookingDoc(d.bookingId).data.weddingId == d.weddingId
        && vendorOwnerUid(bookingDoc(d.bookingId).data.vendorId) == d.recipientUid;
    }

    function notificationActorIsBookingVendor() {
      let d = request.resource.data;
      return d.keys().hasAny(['bookingId'])
        && d.bookingId is string
        && exists(/databases/$(database)/documents/bookings/$(d.bookingId))
        && bookingDoc(d.bookingId).data.weddingId == d.weddingId
        && isVendorOwner(bookingDoc(d.bookingId).data.vendorId);
    }

    function isValidNotificationCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'id', 'recipientUid', 'weddingId', 'type', 'message',
          'taskId', 'bookingId', 'href', 'priority',
          'read', 'createdAt', 'actorUid', 'actorName'
        ])
        && d.id == request.resource.id
        && d.recipientUid is string && d.recipientUid.size() > 0 && d.recipientUid.size() <= 128
        && d.weddingId is string && d.weddingId.size() > 0 && d.weddingId.size() <= 128
        && notificationTypeAllowed(d.type)
        && d.message is string && d.message.size() > 0 && d.message.size() <= 500
        && (!d.keys().hasAny(['taskId']) || (d.taskId is string && d.taskId.size() > 0 && d.taskId.size() <= 128))
        && (!d.keys().hasAny(['bookingId']) || (d.bookingId is string && d.bookingId.size() > 0 && d.bookingId.size() <= 128))
        && (!d.keys().hasAny(['href']) || (d.href is string && d.href.size() > 0 && d.href.size() <= 300))
        && (!d.keys().hasAny(['priority']) || d.priority in ['normal', 'urgent'])
        && d.read == false
        && d.createdAt is number
        && (!d.keys().hasAny(['actorUid']) || (d.actorUid is string && d.actorUid.size() <= 128))
        && (!d.keys().hasAny(['actorName']) || (d.actorName is string && d.actorName.size() <= 80))
        && (
          // Family/collaborator → fellow member (tasks) or booking vendor
          (isWeddingMember(d.weddingId)
            && (notificationRecipientIsWeddingMember() || notificationRecipientIsBookingVendor()))
          // Vendor → wedding members on their booking
          || (notificationActorIsBookingVendor() && notificationRecipientIsWeddingMember())
        );
    }

    match /notifications/{notificationId} {
      allow read: if isPlatformAdmin()
        || (isSignedIn() && resource.data.recipientUid == request.auth.uid);
      allow create: if isSignedIn() && isValidNotificationCreate();
      allow update: if isSignedIn()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow delete: if false;
    }

    // Append-only audit trail for scheduled automations (dispute/no-show).
    // Written only by Admin SDK / Cloud Functions. Readable by platform admins.
    match /automation_logs/{logId} {
      allow read: if isPlatformAdmin();
      allow create, update, delete: if false;
    }
  }
}
