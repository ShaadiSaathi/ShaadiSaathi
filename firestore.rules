rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isWeddingMember(weddingId) {
      return isSignedIn()
        && weddingId != null
        && request.auth.uid in get(/databases/$(database)/documents/weddings/$(weddingId)).data.memberUids;
    }

    /** Financial approvals — only the wedding ownerId (not collaborators). */
    function isWeddingOwner(weddingId) {
      return isSignedIn()
        && weddingId != null
        && get(/databases/$(database)/documents/weddings/$(weddingId)).data.ownerId == request.auth.uid;
    }

    function isVendorOwner(vendorId) {
      return isSignedIn()
        && vendorId != null
        && get(/databases/$(database)/documents/vendors/$(vendorId)).data.ownerUid == request.auth.uid;
    }

    /** Ownership and premium are Admin SDK only after create. */
    function weddingOwnershipFieldsUnchanged() {
      return request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.memberUids == resource.data.memberUids;
    }

    function weddingPremiumUnchanged() {
      return request.resource.data.isPremium == resource.data.isPremium;
    }

    function isValidWeddingCreate(weddingId) {
      let d = request.resource.data;
      return d.ownerId == request.auth.uid
        && d.id == weddingId
        && d.memberUids is list
        && d.memberUids.size() == 1
        && request.auth.uid in d.memberUids
        && d.isPremium == false
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120;
    }

    /** Non-financial booking touch (message read receipts). */
    function bookingFamilyReadReceiptOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['lastReadByFamily']);
    }

    function bookingImmutableFieldsUnchanged() {
      return request.resource.data.weddingId == resource.data.weddingId
        && request.resource.data.vendorId == resource.data.vendorId
        && request.resource.data.get('createdByUid', '') == resource.data.get('createdByUid', '')
        && request.resource.data.get('createdAt', 0) == resource.data.get('createdAt', 0)
        && request.resource.data.get('payment', null) == resource.data.get('payment', null);
    }

    // Clients may keep an already-confirmed booking confirmed, or move to
    // declined/disputed/requested — but must not transition INTO confirmed.
    // Confirmations claim vendor_date_locks via Admin API only.
    function bookingClientStatusAllowed() {
      let prev = resource.data.status;
      let next = request.resource.data.status;
      return next in ['requested', 'confirmed', 'declined', 'disputed']
        && !(prev != 'confirmed' && next == 'confirmed');
    }

    function bookingDisputeClientOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['dispute'])
        || (
          request.resource.data.dispute is map
          && request.resource.data.dispute.status == 'under_review'
          && !request.resource.data.dispute.keys().hasAny([
            'resolution', 'resolvedAt', 'resolvedByUid', 'autoResolved'
          ])
        );
    }

    function bookingNonPaymentUpdateKeys() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return bookingImmutableFieldsUnchanged()
        && bookingClientStatusAllowed()
        && bookingDisputeClientOk()
        && !changed.hasAny(['payment', 'weddingId', 'vendorId', 'createdByUid', 'createdAt', 'id'])
        && changed.hasOnly([
          'status', 'price', 'packageName', 'guestCount', 'note',
          'counterOffer', 'dispute', 'extraWorkRequest',
          'lastReadByFamily', 'lastReadByVendor', 'updatedAt', 'eventDate'
        ]);
    }

    function canAccessBooking(bookingId) {
      return isSignedIn()
        && bookingId is string
        && exists(/databases/$(database)/documents/bookings/$(bookingId))
        && (
          isWeddingMember(get(/databases/$(database)/documents/bookings/$(bookingId)).data.weddingId)
          || isVendorOwner(get(/databases/$(database)/documents/bookings/$(bookingId)).data.vendorId)
        );
    }

    function canAccessThread(threadId) {
      return isSignedIn()
        && threadId is string
        && exists(/databases/$(database)/documents/chatThreads/$(threadId))
        && (
          isWeddingMember(get(/databases/$(database)/documents/chatThreads/$(threadId)).data.weddingId)
          || (
            get(/databases/$(database)/documents/chatThreads/$(threadId)).data.type == 'vendor_inquiry'
            && isVendorOwner(get(/databases/$(database)/documents/chatThreads/$(threadId)).data.vendorId)
          )
        );
    }

    function userIdentityLinksOk(d) {
      return d.role in ['family', 'vendor']
        && d.phone is string && d.phone.size() >= 8 && d.phone.size() <= 40
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 80
        && (!d.keys().hasAny(['email']) || (d.email is string && d.email.size() <= 120))
        && (!d.keys().hasAny(['weddingId']) || (
          d.weddingId is string
          && d.weddingId.size() > 0
          && d.weddingId.size() <= 128
          && isWeddingMember(d.weddingId)
        ))
        && (!d.keys().hasAny(['vendorId']) || (
          d.vendorId is string
          && d.vendorId.size() > 0
          && d.vendorId.size() <= 128
          && isVendorOwner(d.vendorId)
        ));
    }

    function isValidUserCreate(userId) {
      let d = request.resource.data;
      return isSignedIn()
        && request.auth.uid == userId
        && d.keys().hasOnly(['uid', 'role', 'phone', 'name', 'createdAt', 'weddingId', 'vendorId', 'email'])
        && d.uid == userId
        && d.createdAt is number
        && userIdentityLinksOk(d);
    }

    function isValidUserUpdate(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && changed.hasOnly(['name', 'email', 'phone', 'role', 'weddingId', 'vendorId'])
        && userIdentityLinksOk(request.resource.data);
    }

    function isPlatformAdmin() {
      return isSignedIn() && request.auth.token.platformAdmin == true;
    }

    /**
     * Vendor owners may edit listing / onboarding fields and submit KYC for review
     * (pending), but cannot self-approve, self-reject, or write CNIC on the public doc.
     */
    function vendorOwnerUpdateAllowed() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let prevStatus = resource.data.get('verificationStatus', 'unverified');
      let nextStatus = request.resource.data.get('verificationStatus', 'unverified');
      let statusOk = nextStatus == prevStatus
        || (nextStatus == 'pending'
          && prevStatus in ['unverified', 'rejected', 'pending']);
      return statusOk
        && !changed.hasAny(['ownerUid', 'verificationReviewedAt', 'verifiedByUid'])
        && !request.resource.data.keys().hasAny(['verificationCnic']);
    }

    function guestRsvpOnlyUpdate() {
      // Public invite link may update RSVP fields without auth.
      let allowed = ['rsvp', 'rsvpSource', 'updatedAt', 'rsvpUpdatedAt', 'rsvpOrganiserAlert'];
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(allowed);
    }

    // Unauthenticated wedding-invite self-claim (create only). Doc id must
    // equal inviteToken; wedding must exist; RSVP fields start as pending.
    function isPublicWeddingGuestClaim() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'id', 'weddingId', 'name', 'phone', 'events',
          'rsvp', 'rsvpSource', 'rsvpUpdatedAt', 'rsvpOrganiserAlert',
          'inviteToken', 'notes', 'updatedAt'
        ])
        && d.weddingId is string
        && d.weddingId.size() > 0
        && d.weddingId.size() <= 128
        && exists(/databases/$(database)/documents/weddings/$(d.weddingId))
        && d.name is string
        && d.name.size() >= 2
        && d.name.size() <= 80
        && d.inviteToken is string
        && d.inviteToken == request.resource.id
        && d.id is string
        && d.phone is string
        && d.phone.size() <= 40
        && d.events is list
        && d.rsvp is map
        && d.rsvpSource is map
        && d.rsvpUpdatedAt is map
        && d.rsvpOrganiserAlert is map
        && d.updatedAt is number
        && (!d.keys().hasAny(['notes']) || (d.notes is string && d.notes.size() <= 200));
    }

    // Client-side OTP audit logs (written pre-auth). Shape/size limited;
    // readable by platform admin claim or Admin SDK only.
    function isValidVerificationError() {
      let d = request.resource.data;
      return d.keys().hasOnly(['flow', 'stage', 'code', 'message', 'rawCode', 'rawMessage', 'phone', 'uid', 'timestamp'])
        && d.flow is string && d.flow.size() <= 40
        && d.stage is string && d.stage.size() <= 20
        && d.code is string && d.code.size() <= 100
        && d.message is string && d.message.size() <= 500
        && (!d.keys().hasAny(['rawCode']) || (d.rawCode is string && d.rawCode.size() <= 100))
        && (!d.keys().hasAny(['rawMessage']) || (d.rawMessage is string && d.rawMessage.size() <= 500))
        && d.phone is string && d.phone.size() <= 40
        && d.uid is string && d.uid.size() <= 128
        && d.timestamp is number;
    }

    function isValidVerificationSuccess() {
      let d = request.resource.data;
      return d.keys().hasOnly(['flow', 'phone', 'verificationId', 'hasVerificationId', 'uid', 'timestamp'])
        && d.flow is string && d.flow.size() <= 40
        && d.phone is string && d.phone.size() <= 40
        && d.verificationId is string && d.verificationId.size() > 0 && d.verificationId.size() <= 24
        && d.hasVerificationId is bool && d.hasVerificationId == true
        && d.uid is string && d.uid.size() <= 128
        && d.timestamp is number;
    }

    match /users/{userId} {
      allow read: if isPlatformAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isValidUserCreate(userId);
      allow update: if isValidUserUpdate(userId);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /weddings/{weddingId} {
      // Invite pages use /api/invite/wedding/[id] for public fields.
      // Full docs (organiserPhone, memberUids, shareCode) are members/admin only.
      allow get: if isWeddingMember(weddingId) || isPlatformAdmin();
      allow list: if isWeddingMember(weddingId) || isPlatformAdmin();
      allow create: if isSignedIn() && isValidWeddingCreate(weddingId);
      allow update: if isPlatformAdmin()
        || (
          (isWeddingOwner(weddingId) || isWeddingMember(weddingId))
          && weddingOwnershipFieldsUnchanged()
          && weddingPremiumUnchanged()
        );
      allow delete: if isWeddingOwner(weddingId) || isPlatformAdmin();
    }

    match /guests/{inviteToken} {
      allow get: if true;
      allow list: if isPlatformAdmin()
        || (isSignedIn() && isWeddingMember(resource.data.weddingId));
      allow create: if (isSignedIn()
          && isWeddingMember(request.resource.data.weddingId))
        || isPublicWeddingGuestClaim();
      allow delete: if isSignedIn()
        && isWeddingMember(resource.data.weddingId);
      allow update: if isWeddingMember(resource.data.weddingId)
        || guestRsvpOnlyUpdate();
    }

    match /tasks/{taskId} {
      allow read: if isPlatformAdmin() || (isSignedIn()
        && isWeddingMember(resource.data.weddingId));
      allow create: if isSignedIn()
        && isWeddingMember(request.resource.data.weddingId);
      allow update, delete: if isSignedIn()
        && isWeddingMember(resource.data.weddingId);
    }

    match /vendors/{vendorId} {
      allow read: if true;
      // New vendors must start unverified — they cannot self-approve for payments.
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.verificationStatus == 'unverified'
        && !request.resource.data.keys().hasAny(['verificationCnic']);
      allow update: if isPlatformAdmin()
        || (isVendorOwner(vendorId) && vendorOwnerUpdateAllowed());
      allow delete: if isVendorOwner(vendorId) || isPlatformAdmin();
    }

    // Sensitive bank/IBAN details for Safepay payouts — NOT on the public vendors doc.
    // Owner + platform admin only. Never readable by families or other vendors.
    function isValidPayoutAccountWrite(vendorId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'vendorId', 'ownerUid', 'iban', 'accountHolderName', 'bankName',
          'accountNumber', 'createdAt', 'updatedAt'
        ])
        && d.vendorId == vendorId
        && d.ownerUid == request.auth.uid
        && d.iban is string && d.iban.size() >= 24 && d.iban.size() <= 34
        && d.accountHolderName is string
          && d.accountHolderName.size() >= 2 && d.accountHolderName.size() <= 120
        && d.bankName is string
          && d.bankName.size() >= 2 && d.bankName.size() <= 120
        && (!('accountNumber' in d) || (d.accountNumber is string && d.accountNumber.size() <= 40))
        && d.createdAt is number
        && d.updatedAt is number;
    }

    match /vendor_payout_accounts/{vendorId} {
      allow read: if isPlatformAdmin()
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isSignedIn()
        && isVendorOwner(vendorId)
        && isValidPayoutAccountWrite(vendorId);
      allow update: if isPlatformAdmin()
        || (isSignedIn()
          && isVendorOwner(vendorId)
          && resource.data.ownerUid == request.auth.uid
          && isValidPayoutAccountWrite(vendorId)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if isPlatformAdmin()
        || (isSignedIn()
          && isVendorOwner(vendorId)
          && resource.data.ownerUid == request.auth.uid);
    }

    match /bookings/{bookingId} {
      allow read: if isPlatformAdmin() || (isSignedIn() && (
        isWeddingMember(resource.data.weddingId)
        || isVendorOwner(resource.data.vendorId)
      ));
      // Confirmed bookings must be created via Admin API (/api/bookings/create)
      // so platform-wide date locks can be claimed atomically. Clients may not
      // write confirmed bookings directly.
      allow create: if isPlatformAdmin()
        || (isSignedIn()
          && isWeddingOwner(request.resource.data.weddingId)
          && request.resource.data.status == 'requested');
      // Payment fields are Admin SDK only (Stripe webhook / payment APIs).
      // Owner/vendor may update status, quotes, disputes — not payment.
      allow update: if isPlatformAdmin()
        || (isSignedIn()
          && isVendorOwner(resource.data.vendorId)
          && bookingNonPaymentUpdateKeys())
        || (isSignedIn()
          && isWeddingOwner(resource.data.weddingId)
          && bookingNonPaymentUpdateKeys())
        || (isSignedIn()
          && isWeddingMember(resource.data.weddingId)
          && bookingFamilyReadReceiptOnly());
      allow delete: if isWeddingOwner(resource.data.weddingId) || isPlatformAdmin();
    }

    // Denormalized confirmed-date locks for a vendor (vendorId_YYYY-MM-DD).
    // Written only by Admin SDK during booking create. Families/vendors may read
    // to show "Not available on …" before attempting a booking.
    match /vendor_date_locks/{lockId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create, update, delete: if false;
    }

    match /messages/{messageId} {
      function validMessageCreate() {
        let d = request.resource.data;
        let hasBooking = d.keys().hasAny(['bookingId']);
        let hasThread = d.keys().hasAny(['threadId']);
        let hasText = d.keys().hasAny(['text']) && d.text is string && d.text.size() > 0 && d.text.size() <= 2000;
        let hasImage = d.keys().hasAny(['imageUrl']) && d.imageUrl is string && d.imageUrl.size() > 0 && d.imageUrl.size() <= 2000;
        return d.keys().hasOnly([
            'bookingId', 'threadId', 'senderId', 'senderType', 'senderName',
            'text', 'imageUrl', 'timestamp'
          ])
          && ((hasBooking && !hasThread) || (!hasBooking && hasThread))
          && d.senderId == request.auth.uid
          && d.senderType in ['family', 'vendor']
          && (!d.keys().hasAny(['senderName']) || (d.senderName is string && d.senderName.size() <= 80))
          && (hasText || hasImage)
          && (!hasText || (d.text is string && d.text.size() <= 2000))
          && d.timestamp is number
          && (
            (hasBooking && canAccessBooking(d.bookingId))
            || (hasThread && canAccessThread(d.threadId))
          );
      }

      allow read: if isPlatformAdmin()
        || (isSignedIn() && (
          (resource.data.keys().hasAny(['bookingId']) && canAccessBooking(resource.data.bookingId))
          || (resource.data.keys().hasAny(['threadId']) && canAccessThread(resource.data.threadId))
        ));
      allow create: if isSignedIn() && validMessageCreate();
      allow update, delete: if false;
    }

    match /chatThreads/{threadId} {
      function threadReadable() {
        return isWeddingMember(resource.data.weddingId)
          || (
            resource.data.type == 'vendor_inquiry'
            && isVendorOwner(resource.data.vendorId)
          );
      }
      function validThreadCreate() {
        let d = request.resource.data;
        return d.keys().hasOnly([
            'id', 'type', 'weddingId', 'vendorId', 'vendorName',
            'createdAt', 'updatedAt', 'lastMessageAt', 'lastMessagePreview',
            'createdByUid'
          ])
          && d.id == threadId
          && d.type in ['vendor_inquiry', 'family_consult']
          && d.weddingId is string
          && d.vendorId is string
          && d.vendorName is string && d.vendorName.size() > 0 && d.vendorName.size() <= 120
          && d.createdAt is number
          && d.updatedAt is number
          && d.createdByUid == request.auth.uid
          && isWeddingMember(d.weddingId)
          && (
            d.type == 'family_consult'
            || exists(/databases/$(database)/documents/vendors/$(d.vendorId))
          );
      }
      function validThreadTouch() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return changed.hasOnly(['updatedAt', 'lastMessageAt', 'lastMessagePreview'])
          && request.resource.data.updatedAt is number
          && request.resource.data.lastMessageAt is number
          && request.resource.data.lastMessagePreview is string
          && request.resource.data.lastMessagePreview.size() <= 140;
      }

      allow read: if isPlatformAdmin() || (isSignedIn() && threadReadable());
      allow create: if isSignedIn() && validThreadCreate();
      allow update: if isSignedIn()
        && validThreadTouch()
        && (
          isWeddingMember(resource.data.weddingId)
          || (
            resource.data.type == 'vendor_inquiry'
            && isVendorOwner(resource.data.vendorId)
          )
        );
      allow delete: if false;
    }

    match /typing/{scopeId} {
      allow read, write: if canAccessBooking(scopeId) || canAccessThread(scopeId);
    }

    match /events/{eventId} {
      allow read: if isPlatformAdmin()
        || (isSignedIn() && isWeddingMember(resource.data.weddingId));
      allow create: if isSignedIn() && isWeddingMember(request.resource.data.weddingId);
      allow update: if isSignedIn()
        && isWeddingMember(resource.data.weddingId)
        && request.resource.data.weddingId == resource.data.weddingId;
      allow delete: if isSignedIn() && isWeddingMember(resource.data.weddingId);
    }

    // OTP audit logs: clients may create (pre-auth) with strict validation;
    // only platform admins may read. Updates/deletes are forbidden.
    match /verification_errors/{errorId} {
      allow create: if isValidVerificationError();
      allow read: if isPlatformAdmin();
      allow update, delete: if false;
    }

    match /verification_success/{successId} {
      allow create: if isValidVerificationSuccess();
      allow read: if isPlatformAdmin();
      allow update, delete: if false;
    }

    function isValidCollaboratorInviteCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'id', 'weddingId', 'phone', 'invitedByUid', 'invitedByName',
          'weddingName', 'status', 'createdAt'
        ])
        && d.weddingId is string && d.weddingId.size() > 0 && d.weddingId.size() <= 128
        && d.phone is string && d.phone.size() >= 8 && d.phone.size() <= 20
        && d.invitedByUid is string && d.invitedByUid == request.auth.uid
        && d.invitedByName is string && d.invitedByName.size() <= 80
        && d.weddingName is string && d.weddingName.size() <= 120
        && d.status == 'pending'
        && d.createdAt is number
        && isWeddingMember(d.weddingId);
    }

    function collaboratorInvitePhoneMatchesUser() {
      return resource.data.phone == userDoc().data.phone;
    }

    match /wedding_collaborator_invites/{inviteId} {
      allow read: if isPlatformAdmin()
        || (isSignedIn() && isWeddingMember(resource.data.weddingId))
        || (isSignedIn() && collaboratorInvitePhoneMatchesUser());
      allow create: if isSignedIn() && isValidCollaboratorInviteCreate();
      allow update: if isPlatformAdmin()
        || (isSignedIn()
          && isWeddingMember(resource.data.weddingId)
          && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        || (isSignedIn()
          && collaboratorInvitePhoneMatchesUser()
          && resource.data.status == 'pending'
          && request.resource.data.status == 'declined'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if false;
    }

    // In-app notifications inbox. Recipients may only read/update their own
    // docs. Wedding members and booking vendors may create for the other party.
    function notificationTypeAllowed(t) {
      return t in [
        'task_assigned', 'task_due_soon',
        'booking_request', 'quote_received', 'quote_accepted', 'quote_rejected',
        'extra_work_needed', 'dispute_raised', 'dispute_vendor_response',
        'dispute_auto_resolved', 'no_show_declared',
        'booking_message', 'vendor_inquiry_message', 'family_consult_message',
        'vendor_verification_approved', 'vendor_verification_rejected'
      ];
    }

    function bookingDoc(bookingId) {
      return get(/databases/$(database)/documents/bookings/$(bookingId));
    }

    function vendorOwnerUid(vendorId) {
      return get(/databases/$(database)/documents/vendors/$(vendorId)).data.ownerUid;
    }

    function notificationRecipientIsWeddingMember() {
      let d = request.resource.data;
      return d.recipientUid in get(/databases/$(database)/documents/weddings/$(d.weddingId)).data.memberUids;
    }

    function notificationRecipientIsBookingVendor() {
      let d = request.resource.data;
      return d.keys().hasAny(['bookingId'])
        && d.bookingId is string
        && exists(/databases/$(database)/documents/bookings/$(d.bookingId))
        && bookingDoc(d.bookingId).data.weddingId == d.weddingId
        && vendorOwnerUid(bookingDoc(d.bookingId).data.vendorId) == d.recipientUid;
    }

    function notificationActorIsBookingVendor() {
      let d = request.resource.data;
      return d.keys().hasAny(['bookingId'])
        && d.bookingId is string
        && exists(/databases/$(database)/documents/bookings/$(d.bookingId))
        && bookingDoc(d.bookingId).data.weddingId == d.weddingId
        && isVendorOwner(bookingDoc(d.bookingId).data.vendorId);
    }

    function notificationRecipientIsInquiryVendor() {
      let d = request.resource.data;
      return d.keys().hasAny(['vendorId'])
        && d.vendorId is string
        && exists(/databases/$(database)/documents/vendors/$(d.vendorId))
        && vendorOwnerUid(d.vendorId) == d.recipientUid;
    }

    function notificationActorIsInquiryVendor() {
      let d = request.resource.data;
      return d.keys().hasAny(['vendorId'])
        && d.vendorId is string
        && isVendorOwner(d.vendorId);
    }

    function isValidNotificationCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'id', 'recipientUid', 'weddingId', 'type', 'message',
          'taskId', 'bookingId', 'vendorId', 'threadId', 'href', 'priority',
          'read', 'createdAt', 'actorUid', 'actorName'
        ])
        && d.id == request.resource.id
        && d.recipientUid is string && d.recipientUid.size() > 0 && d.recipientUid.size() <= 128
        && d.weddingId is string && d.weddingId.size() > 0 && d.weddingId.size() <= 128
        && notificationTypeAllowed(d.type)
        && d.message is string && d.message.size() > 0 && d.message.size() <= 500
        && (!d.keys().hasAny(['taskId']) || (d.taskId is string && d.taskId.size() > 0 && d.taskId.size() <= 128))
        && (!d.keys().hasAny(['bookingId']) || (d.bookingId is string && d.bookingId.size() > 0 && d.bookingId.size() <= 128))
        && (!d.keys().hasAny(['vendorId']) || (d.vendorId is string && d.vendorId.size() > 0 && d.vendorId.size() <= 128))
        && (!d.keys().hasAny(['threadId']) || (d.threadId is string && d.threadId.size() > 0 && d.threadId.size() <= 160))
        && (!d.keys().hasAny(['href']) || (d.href is string && d.href.size() > 0 && d.href.size() <= 300))
        && (!d.keys().hasAny(['priority']) || d.priority in ['normal', 'urgent'])
        && d.read == false
        && d.createdAt is number
        && (!d.keys().hasAny(['actorUid']) || (d.actorUid is string && d.actorUid.size() <= 128))
        && (!d.keys().hasAny(['actorName']) || (d.actorName is string && d.actorName.size() <= 80))
        && (
          // Family/collaborator → fellow member (tasks/consult) or booking/inquiry vendor
          (isWeddingMember(d.weddingId)
            && (
              notificationRecipientIsWeddingMember()
              || notificationRecipientIsBookingVendor()
              || (
                d.type in ['vendor_inquiry_message', 'family_consult_message', 'booking_message']
                && notificationRecipientIsInquiryVendor()
              )
            ))
          // Vendor → wedding members on their booking or inquiry
          || (notificationActorIsBookingVendor() && notificationRecipientIsWeddingMember())
          || (
            notificationActorIsInquiryVendor()
            && notificationRecipientIsWeddingMember()
            && d.type == 'vendor_inquiry_message'
          )
        );
    }

    match /notifications/{notificationId} {
      allow read: if isPlatformAdmin()
        || (isSignedIn() && resource.data.recipientUid == request.auth.uid);
      allow create: if isSignedIn() && isValidNotificationCreate();
      allow update: if isSignedIn()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow delete: if false;
    }

    // Append-only audit trail for scheduled automations (dispute/no-show).
    // Written only by Admin SDK / Cloud Functions. Readable by platform admins.
    match /automation_logs/{logId} {
      allow read: if isPlatformAdmin();
      allow create, update, delete: if false;
    }

    // Wedding AI Q&A history — written/read via Admin SDK API routes only
    // (/api/wedding-chat + /api/wedding-chat/history) with premium membership checks.
    match /weddingChatHistory/{entryId} {
      allow read, write: if false;
    }

    // Daily Wedding AI quotas + top-ups — Admin SDK only.
    match /weddingAiUsage/{usageId} {
      allow read, write: if false;
    }

    match /healthChecks/{checkId} {
      allow read, write: if false;
    }

    match /otp_rate_limits/{limitId} {
      allow read, write: if false;
    }

    // CNIC / national ID — never on the public vendors listing.
    function isValidVendorKycWrite(vendorId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'vendorId', 'ownerUid', 'verificationCnic',
          'verificationBusinessName', 'verificationCity',
          'submittedAt', 'updatedAt'
        ])
        && d.vendorId == vendorId
        && d.ownerUid == request.auth.uid
        && d.verificationCnic is string
        && d.verificationCnic.size() >= 5
        && d.verificationCnic.size() <= 20
        && d.verificationBusinessName is string
        && d.verificationBusinessName.size() >= 2
        && d.verificationBusinessName.size() <= 120
        && d.verificationCity is string
        && d.verificationCity.size() >= 2
        && d.verificationCity.size() <= 80
        && d.submittedAt is number
        && d.updatedAt is number;
    }

    match /vendor_kyc/{vendorId} {
      allow read: if isPlatformAdmin()
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isSignedIn()
        && isVendorOwner(vendorId)
        && isValidVendorKycWrite(vendorId);
      allow update: if isPlatformAdmin()
        || (isSignedIn()
          && isVendorOwner(vendorId)
          && resource.data.ownerUid == request.auth.uid
          && isValidVendorKycWrite(vendorId)
          && request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isPlatformAdmin()
        || (isSignedIn()
          && isVendorOwner(vendorId)
          && resource.data.ownerUid == request.auth.uid);
    }
  }
}
